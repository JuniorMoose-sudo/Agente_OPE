# Copie para .env e preencha. .env NUNCA deve ser commitado.

# Conexão Postgres (string SQLAlchemy)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agente_ope

# Proxxima Connect (login ASP.NET: usuário/senha)
PROXXIMA_USER=
PROXXIMA_PASSWORD=

# painel-ope (cookie de sessão "ope_session")
OPE_SESSION_COOKIE=

# API própria — token que o plugin do agente envia em Authorization: Bearer
OPS_API_TOKEN=
# URL do backend que o plugin consulta (porta 8000 é usada pelo ProxximaDashboard)
OPS_API_URL=http://localhost:8100

# Telegram (alertas de manutenção)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets — service account
# Opção 1 (recomendada): caminho para o arquivo JSON da service account
SHEETS_SERVICE_ACCOUNT_FILE=credencial.json
# Opção 2: string JSON completa (menos prática)
SHEETS_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_URL=
SHEETS_ABA_INSPECAO=Inspecao
